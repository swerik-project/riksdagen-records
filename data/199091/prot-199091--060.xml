        <note xml:id="i-PqWJpKoNvpj5JfiCXgWqah" type="title">
          1 § Meddelande om ändring i kammarens sammanträdesplan
        </note>
        <note xml:id="i-4s4bKvuGNdDUsNCNswWzy9" type="speaker">
          Anf. 1 FÖRSTE VICE TALMANNEN:
        </note>
        <note xml:id="i-LUd6Wv2Zia3H9NuBLV33Kf">
